# Copy to .env and fill in your own keys. Never commit .env.

# Executive Producer + Creative Director (Anthropic Claude)
ANTHROPIC_API_KEY=

# Strategist (Google Gemini)
GEMINI_API_KEY=

# Social & Precedent Analyst (xAI Grok, via litellm)
XAI_API_KEY=

# Facoltativa: modelli open via Featherless (abbonamento flat, litellm
# `featherless_ai/<org>/<modello>`). Serve solo se una testa li usa.
FEATHERLESS_AI_API_KEY=

# Facoltativa: modelli via OpenRouter (300+ modelli, litellm
# `openrouter/<vendor>/<modello>`). Serve solo se una testa li usa.
OPENROUTER_API_KEY=

# ── D23: ricerche social di Grok ─────────────────────────────────────────
# Grok Live Search nativo (X + web in tempo reale). Opt-in: ha un costo per
# fonte. "auto" lascia decidere a Grok quando cercare.
CREW_GROK_LIVE_SEARCH=
CREW_GROK_LIVE_SEARCH_MAX=10

# Tool "social intel" agganciabile (es. il TikTok analyzer). Comando che riceve
# la query come ULTIMO argomento e scrive un digest su stdout. Spento se vuoto.
# Esempi (leggi un signal.json gia' prodotto, oppure lancia uno scrape live):
#   CREW_SOCIAL_TOOL_CMD=".venv/bin/python3 scripts/social_tool_signal.py"
#   CREW_SOCIAL_TOOL_CMD=".venv/bin/python3 scripts/social_tool_scrape.py"
# Gli script d'esempio leggono il tuo analyzer da TIKTOK_ANALYZER_DIR (nessun
# percorso cablato nel repo pubblico).
CREW_SOCIAL_TOOL_CMD=
CREW_SOCIAL_TOOL_TIMEOUT=180
TIKTOK_ANALYZER_DIR=
